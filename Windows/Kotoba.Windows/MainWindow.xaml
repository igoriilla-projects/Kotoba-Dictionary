<Window x:Class="Kotoba.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Kotoba" Width="976" Height="739" MinWidth="816" MinHeight="679" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Grid Background="{StaticResource Paper}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#40FFFFFF"><DockPanel Margin="24">
      <StackPanel DockPanel.Dock="Top"><TextBlock Text="字" FontFamily="{StaticResource Japanese}" FontSize="44" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/><TextBlock Text="K O T O B A" FontFamily="Consolas" FontSize="20" FontWeight="Bold"/><TextBlock Text="Японский понемногу каждый день" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,42"/>
        <StackPanel x:Name="Navigation"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom"><Border Height="1" Background="#3029332E" Margin="0,0,0,18"/><TextBlock Text="ВАША УЧЕБНАЯ БИБЛИОТЕКА" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource Muted}"/><TextBlock x:Name="KanjiCount" Margin="0,10,0,4"/><TextBlock x:Name="WordCount"/><TextBlock Text="✓  Доступно без интернета" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,18,0,0"/></StackPanel>
      <Border/>
    </DockPanel></Border>
    <Border Grid.Column="1" Background="#1A29332E"/>
    <Grid Grid.Column="2" Margin="36">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,26"><TextBlock x:Name="Eyebrow" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,9"/><DockPanel><ComboBox x:Name="ContentFilter" DockPanel.Dock="Right" Width="140" SelectionChanged="ContentChanged"/><TextBlock x:Name="PageTitle" FontFamily="Georgia" FontSize="30" TextWrapping="Wrap"/></DockPanel></StackPanel>
      <Border x:Name="ErrorBanner" Grid.Row="1" Background="#12B53D26" CornerRadius="6" Padding="12" Margin="0,0,0,14" Visibility="Collapsed"><StackPanel><TextBlock x:Name="ErrorText" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/><Button Content="Повторить" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Retry"/></StackPanel></Border>
      <Grid x:Name="Body" Grid.Row="2"/>
    </Grid>
  </Grid>
</Window>
