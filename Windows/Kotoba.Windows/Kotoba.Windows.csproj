<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AssemblyName>Kotoba</AssemblyName>
    <Version>1.4.1</Version><ApplicationManifest>app.manifest</ApplicationManifest>
    <AppHostDotNetSearch>AppRelative;Global</AppHostDotNetSearch><AppHostRelativeDotNet>.runtime</AppHostRelativeDotNet>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Kotoba.Core/Kotoba.Core.csproj" />
    <Resource Include="Assets/NotoSerifCJKjp-Regular.otf" />
    <Content Include="Assets/OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../LICENSE" Link="Licenses/Kotoba-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../THIRD_PARTY_NOTICES.md" Link="Licenses/THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Vendor/SwiftFSRS/LICENSE" Link="Licenses/SwiftFSRS-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Data/dictionary.sqlite" Link="Data/dictionary.sqlite" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
